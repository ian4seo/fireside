                const listItems = pagination.getElementsByTagName('li');

                // Check if there are any <li> elements and delete the last one
                if (listItems.length > 0) {
                    const lastItem = listItems[listItems.length - 1];
                    lastItem.remove(); // Remove the last <li> element
                    console.log("removed")
                }
            }

            //removed list item returns when sliders are paged
            splider.destroy();
            splider.refresh();
            splider.mount();

            modal.style.display = "none";
        }

        // Close the modal when clicking outside of it
