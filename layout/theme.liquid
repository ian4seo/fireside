{% capture content %}
<!DOCTYPE html>
<html class="no-js no-touch" lang="{{ request.locale.iso_code }}">
  <head>
    
    <!-- Google Tag Manager -->
    <script>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    </script>
    <script data-performance-src="https://www.googletagmanager.com/gtm.js?id=GTM-KZTT2WV"></script>
    <!-- End Google Tag Manager -->
    
    <meta charset="utf-8">
    <meta http-equiv="cleartype" content="on">
    <meta name="robots" content="index,follow">
    <meta name="google-site-verification" content="R9m4Scsr0MZTAxCEZPOYLbsCfpMhCsYuVSFPNJR1z0s" />
    <meta http-equiv="Content-Security-Policy" content="object-src 'none'; script-src * 'unsafe-inline' 'unsafe-eval';">
    <script data-performance-src="https://js.convertflow.co/production/websites/43012.js"></script>
    <!-- Mobile Specific Metas -->
    <meta name="HandheldFriendly" content="True">
    <meta name="MobileOptimized" content="320">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.shop_bg_color }}">

    {% if current_tags %}{% assign meta_tags = current_tags | join: ', ' %}{% endif %}

    {% if collection.handle == 'all' %}
    <title>Fireplaces, Stoves, Inserts, Mantels & Fire Pits | Fireside Hearth & Home</title>
    <meta name="description" content="See what fireplaces, stoves, inserts, mantels, and fire pits are available from Fireside Hearth and Home. Click here to learn more."/>    
    {% else %}
    <title>
      {% if template contains "index" %}
        {{ page_title }}
      {% else %}
        {{ page_title }}
        {% if current_tags %}
           {{ 'general.meta.tagged_html' | t: tags: meta_tags }}
        {% endif %}
        {% if current_page != 1 %}
           {{ 'general.meta.page' | t: page_number: current_page }}
        {% endif %}
        {% unless page_title contains shop.name %} - {{ shop.name }}{% endunless %}
      {% endif %}
    </title>
    {% endif %}

    {% if page_description %}
      <meta name="description" content="{% if template contains 'search' %} {{ page_title }} - {{ shop.name }} {% else %}{{ page_description | escape }}{% if current_tags %} {{ 'general.meta.tagged_html' | t: tags: meta_tags | escape }}.{% endif %}{% if current_page != 1 %} {{ 'general.meta.page' | t: page_number: current_page }}.{% endif %}{% endif %}"/>
    {% endif %}

    <!-- Preconnect Domains -->
    <link rel="preconnect" href="https://fonts.shopifycdn.com" />
    <link rel="preconnect" href="https://cdn.shopify.com" />
    <link rel="preconnect" href="https://v.shopify.com" />
    <link rel="preconnect" href="https://cdn.shopifycloud.com" />
    <link rel="preconnect" href="https://monorail-edge.shopifysvc.com">

    <!-- fallback for browsers that don't support preconnect -->
    <link rel="dns-prefetch" href="https://fonts.shopifycdn.com" />
    <link rel="dns-prefetch" href="https://cdn.shopify.com" />
    <link rel="dns-prefetch" href="https://v.shopify.com" />
    <link rel="dns-prefetch" href="https://cdn.shopifycloud.com" />
    <link rel="dns-prefetch" href="https://monorail-edge.shopifysvc.com">

    <!-- Stylesheet for Fancybox library -->
    <link rel="stylesheet" href="{{ 'fancybox.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'fancybox.css' | asset_url | stylesheet_tag }}</noscript>

    <!-- Stylesheets for Turbo -->
    {{ 'styles.css' | asset_url | stylesheet_tag }}

    <!-- Brando Styleguide CSS -->
    {{ 'styleguide.css' | asset_url | stylesheet_tag }}

    <!-- Brando Stylesheet for Functional CSS -->
    {{ 'functional.css' | asset_url | stylesheet_tag }}

    <!-- Stylesheet for Custom styling -->
    {{ 'custom.css' | asset_url | stylesheet_tag }}

    <!-- Minion Pro -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin>
    <link rel="stylesheet" href="https://use.typekit.net/puj7hzp.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://use.typekit.net/puj7hzp.css"></noscript>

