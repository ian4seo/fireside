      <script>
      // Add SMS disclaimer to Find Your Insert quiz form 
      (function() {
        // Wait for DOM to be fully loaded
        function addDisclaimer() {
          // Find the submit button specifically in form ID 127135
          const submitBtn = document.querySelector('#globo-formbuilder-127135 button.wizard__submit[data-action-next]');
          
          if (!submitBtn) {
            console.log('Submit button not found in form 127135, retrying...');
            return false;
          }
          
          // Check if disclaimer already exists to avoid duplicates
          if (document.querySelector('#globo-formbuilder-127135 .sms-form-disclaimer')) {
            return true;
          }
          
          // Create disclaimer container
          const disclaimer = document.createElement('div');
          disclaimer.className = 'sms-form-disclaimer';
          disclaimer.style.cssText = `
            margin-top: 12px;
            font-size: 13px;
            line-height: 1.5;
            color: #3d3d3d;
            font-family: minion-pro;
          `;
          
          // Add disclaimer text with link
          disclaimer.innerHTML = `
            By submitting, you authorize Fireside to text/call the number above possibly using automated means &/or AI-generated calls/content. Msg/data rates apply, msg frequency varies. Consent is not a condition of purchase. <a href="https://legal.podium.com/#aup-us" style="color: #0066cc; text-decoration: underline;">See terms.</a> Text HELP for help and STOP to unsubscribe.
          `;
          
          // Insert disclaimer after the submit button
          submitBtn.parentNode.insertBefore(disclaimer, submitBtn.nextSibling);
          
          console.log('SMS disclaimer added successfully');
          return true;
        }
        
        // Try to add disclaimer immediately
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            // Try multiple times in case form is dynamically loaded
            let attempts = 0;
            const maxAttempts = 20;
            const interval = setInterval(function() {
              attempts++;
              if (addDisclaimer() || attempts >= maxAttempts) {
                clearInterval(interval);
              }
            }, 200);
          });
        } else {
          // DOM already loaded, try immediately
          let attempts = 0;
          const maxAttempts = 20;
          const interval = setInterval(function() {
            attempts++;
            if (addDisclaimer() || attempts >= maxAttempts) {
              clearInterval(interval);
            }
          }, 200);
        }
        
        // Also watch for step changes in multi-step forms
        const observer = new MutationObserver(function(mutations) {
          addDisclaimer();
        });
        
        // Start observing when DOM is ready
        if (document.body) {
          observer.observe(document.body, {
            childList: true,
            subtree: true
          });
        }
      })();
      // End of SMS disclaimer 
      </script>
