    <script>
    /* Hide prices on stellar quick search */
    document.addEventListener('DOMContentLoaded', () => {
      const hideStellarPrices = (root) => {
        const vendorElements = root.matches && root.matches('.boost-pfs-search-suggestion-product-vendor')
          ? [root]
          : root.querySelectorAll('.boost-pfs-search-suggestion-product-vendor');

        vendorElements.forEach(vendor => {
          if (vendor.textContent.trim() === 'Stellar') {
            const parentContainer = vendor.closest('.boost-pfs-search-suggestion-item');
            if (parentContainer) {
              const priceElement = parentContainer.querySelector('.boost-pfs-search-suggestion-product-regular-price');
              if (priceElement) {
                priceElement.style.display = 'none';
              }
            }
          }
        });
      };

      hideStellarPrices(document);

      const observer = new MutationObserver(mutations => {
        mutations.forEach(mutation => {
          mutation.addedNodes.forEach(node => {
            if (node.nodeType === Node.ELEMENT_NODE) hideStellarPrices(node);
          });
        });
      });
      observer.observe(document.body, { childList: true, subtree: true });
    });
    </script>






    
