            modal.style.display = "none";
        }
        var localData = localStorage.getItem('State'); // Ensure 'State' is in quotes
        if (localData !== null && localData !== 'No') {
            let elements = document.getElementsByClassName(localData);
            for (let i = 0; i < elements.length; i++) {
                let contents = elements[i].innerHTML; // Accessing the innerHTML directly
                splider.add(contents);
            }
            splider.destroy();
            splider.refresh();
            splider.mount();

            modal.style.display = "none"; // Close modal after accepting
            console.log("Data processed:", localData); // Log the processed data
