                    let contents = elements.length > 0 ? elements[i].innerHTML : ''; // Accessing the first element's innerHTML
                    splider.add(contents);
                }
                splider.destroy();
                splider.refresh();
                splider.mount();
            });

            modal.style.display = "none"; // Close modal after accepting
        }


        // Declines to share location
