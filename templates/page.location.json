        "hours": "<h3>Hours</h3>\n        <ul>\n          <li>Monday: 9 AM - 5 PM</li>\n          <li>Tuesday: 9 AM - 5 PM</li>\n          <li>Wednesday: 9 AM - 5 PM</li>\n          <li>Thursday: 9 AM - 5 PM</li>\n          <li>Friday: 9 AM - 5 PM</li>\n          <li>Saturday: 10 AM - 4 PM</li>\n          <li>Sunday: Closed</li>\n        </ul>",
        "locationtitle": "Maple Grove, MN Fireplace Store & Service",
        "infoarea1": "<div style=\"display:flex\">\n<img src=\"https://cdn.shopify.com/s/files/1/0634/4707/2998/files/info1.webp?v=1733414828\" style=\"width: 200px;height: 100%;padding:1em\"><div style=\"padding:1em;\">\n<h4><strong>Fireplace Showroom Design &amp; Sales Consultation</strong></h4>\n<p style=\"font-size:12px\">30 Minute Appointment\nShowroom walk-ins are most common and we don't require an appointment to visit our showroom. But we also understand that your time is valuable, life is busy, and sometimes it's easier to make an appointment. Come see our product displays and work with a sales expert in person. Showroom consults are typically 30 minutes.\n</p>\n<a class=\"btn mobile-margin bg-orange customer-type\" href=\"https://app.acuityscheduling.com/schedule/cbf68096/appointment/15971217/calendar/4282344\">Book Consultation</a>\n</div>\n</div>",
        "infoarea2": "<div style=\"display:flex\">\n<div style=\"padding:1em;\">\n<h4><strong>Request Fireplace Repair and Maintenance Service</strong></h4>\n<p style=\"font-size:12px\">Ensure your fireplace remains a safe and efficient centerpiece in your Minneapolis-St. Paul home with Fireside Hearth &amp; Home's Repair and Maintenance Services. Our factory-trained, certified technicians bring over 100 years of combined experience to each service, offering comprehensive solutions tailored to your fireplace's unique needs.\n</p>\n<a class=\"customer-type text-columns-with-images__button global-button global-button--text\" href=\"https://fireside.com/pages/request-service\">View Request Form</a>\n</div>\n</div>",
        "infoarea3": "<div style=\"display:flex\">\n<img src=\"https://cdn.shopify.com/s/files/1/0634/4707/2998/files/info2.webp?v=1733414828\" style=\"width: 200px;height: 100%;padding:1em\"><div style=\"padding:1em;\">\n<h4><strong>Virtual Sales Consult with Fireside Hearth &amp; Home</strong></h4>\n<p style=\"font-size:12px\">Experience our showrooms virtually by connecting with a sales expert through video on your tablet or phone to discuss your project and show you product options.\n</p>\n<a class=\"btn mobile-margin bg-orange customer-type\" href=\"https://app.acuityscheduling.com/schedule/cbf68096/appointment/15971244/calendar/4282344%0A\">Request Virtual Consultation</a>\n</div>\n</div>"
