          "type": "text_block",
          "settings": {
            "image": "shopify://shop_images/fireside-family-brunch-fit-lg.png",
            "title": "REPLACE YOUR FIREPLACE",
            "text": "<p>Transform your existing fireplace into a fresh design with the added convenience of smart technology. Update just your fireplace or the entire wall - including mantel and stone - for a stunning remodel. </p><p>Fully installed projects starting around $6,800.</p>",
            "button_label": "EXPLORE",
            "button_link": "shopify://pages/replace-my-fireplace"
          }
        }
