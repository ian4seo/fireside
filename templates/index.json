          "settings": {
            "image": "shopify://shop_images/fireside_add_fireplace.jpg",
            "title": "ADD A NEW FIREPLACE",
            "text": "<p>Install a new fireplace in nearly any area of the home. Fireplaces can be added to indoor or outdoor spaces and come in a variety of designs to complement every style. </p><p>Fully installed projects starting around $7,200. </p>",
            "button_label": "EXPLORE",
            "button_link": "shopify://pages/add-new-fireplace"
          }
