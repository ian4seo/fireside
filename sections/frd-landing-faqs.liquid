<script
  type="application/json"
  data-section-type="faq"
  data-section-id="{{ section.id }}"
>
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for block in section.blocks %}
        {% unless block.type == 'heading' %}
          {
            "@type": "Question",
            "name": "{{ block.settings.title | escape }}",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "{{ block.settings.subtitle | strip_html | escape }}"
            }
          }{% unless forloop.last %},{% endunless %}
        {% endunless %}
      {% endfor %}
    ]
  }
</script>

<style>
  .landing-faqs .faqAccordion > dt > button:after {
    font-size: 43px;
    right: 15px !important;
    left: unset!important;
  }
  
  .landing-faqs {
    padding-bottom: 100px!important;
  }
  
  .landing-faqs .title {
    text-align: center!important;
    color: #212626!important;
  }

  @media only screen and (min-width: 798px) {
    .landing-faqs .title {
      font-size: 36px!important;
    }
    .landing-faqs .faqAccordion > dt > button {
      font-size: 20px!important;
    }
    .landing-faqs .faqAccordion > dd {
      font-size: 18px!important;
    }
    .landing-faqs .accordion dt > a:after, .landing-faqs .faqAccordion dt > button:after {
      content: url('https://cdn.shopify.com/s/files/1/0634/4707/2998/files/weui_arrow-filled_2_76d461f0-7321-4aa5-8514-d468d2c5ffe7.png?v=1753286085')!important;
    }
  
    .landing-faqs .accordion dt > a[aria-expanded=true]:after, .landing-faqs .faqAccordion dt > button[aria-expanded=true]:after {
      content: url('https://cdn.shopify.com/s/files/1/0634/4707/2998/files/weui_arrow-filled_3.png?v=1753286123')!important;
    }
  }

  @media only screen and (max-width: 798px) {
    .landing-faqs .title {
      font-size: 30px!important;
    }
    .landing-faqs .faqAccordion > dt > button {
      font-size: 18px!important;
      padding-right: 12%!important;
      padding-left: 0px!important;
    }
    .landing-faqs .faqAccordion > dd p {
      font-size: 18px!important;
    }
    .landing-faqs .accordion dt > a:after, .landing-faqs .faqAccordion dt > button:after {
      content: url('https://cdn.shopify.com/s/files/1/0634/4707/2998/files/weui_arrow-filled_2_76d461f0-7321-4aa5-8514-d468d2c5ffe7.png?v=1753286085')!important;
    }
  
    .landing-faqs .accordion dt > a[aria-expanded=true]:after, .landing-faqs .faqAccordion dt > button[aria-expanded=true]:after {
      content: url('https://cdn.shopify.com/s/files/1/0634/4707/2998/files/weui_arrow-filled_3.png?v=1753286123')!important;
    }
    .accordion>dd, .faqAccordion>dd {
      margin-left: 0px!important;
    }
  }

  .landing-faqs .faqAccordion > dt > button {
    color: #E9841D!important;
    font-family: 'Helvetica'!important;
  }

  .landing-faqs .faqAccordion > dd {
    color: #000!important;
  }

  
</style>

<section class="section landing-faqs">
  <div class="container main content has-background has-gutter-enabled" style="{% if section.settings.less-margin == true %}margin-top: -5em;{% endif %}">
    {% if section.settings.title != blank %}
      <div class="one-whole column page">
        <h2 class="title">
          {{ section.settings.title | escape }}
        </h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          {% assign image = true %}
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="{% if image == true %}one-half{% else %}one-whole{% endif %} medium-down--one-whole column faq faq__column-1">
      {% if section.blocks.size > 0 %}
        <dl class="faqAccordion">
          {% for block in section.blocks %}
            {% if block.type == "heading" %}
              {% if block.settings.faq_title != blank %}
                <h2 class="title faq--heading">
                  {{ block.settings.faq_title }}
                </h2>
              {% endif %}
            {% endif %}
            {% if block.settings.title != blank %}
              <dt>
                <button
                  type="button"
                  aria-controls="panel-01"
                  aria-expanded="true"
                >
                  {{ block.settings.title }}
                </button>
              </dt>
              <dd id="panel-01" aria-hidden="false" class="frd-faq-btn">
                {% if block.settings.title == 'Product Info' %}
                  {{ product.description }}
                {% elsif block.settings.title == 'Specs' %}
                  {{ product.metafields.product.specification_charts }}
                {% elsif product.metafields.product.downloads != blank %}  
                  {{ product.metafields.product.downloads }}
                {% else %}
                  {{ block.settings.answer }}
                {% endif %}
              </dd>
            {% endif %}
          {% endfor %}
        </dl>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          <div
            class="one-half medium-down--one-whole column faq faq--image faq__column-2">
            {% if block.settings.image != blank %}
              {%
                render 'image-element',
                image: block.settings.image,
                alt: block.settings.image.alt
              %}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Landing FAQs",
  "settings": [
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "checkbox",
      "id": "less-margin",
      "label": "Remove top margin",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "FAQ"
    }
  ],
  "blocks": [
    {
      "name": "Frequently Asked Question",
      "type": "content",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Provide the answer to the question here.</p>",
          "info": "If the Question equals Specs then the answer is auto populated with the product description."
        }
      ]
    },
    {
      "name": "Heading",
      "type": "heading",
      "settings": [
        {
          "type": "text",
          "id": "faq_title",
          "label": "Heading",
          "default": "Section heading"
        }
      ]
    },
    {
      "name": "Image",
      "type": "image",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
