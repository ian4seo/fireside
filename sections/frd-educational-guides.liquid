{% comment %}
  Section: Educational Guides
  File:    frd-educational-guides.liquid
  Description: Displays a grid of educational guide cards, each with an icon/image,
               heading, description text, and a CTA button. Defaults to a 3-column
               layout with three fireplace-related guides.
{% endcomment %}

{%- assign section_title    = section.settings.title -%}
{%- assign description      = section.settings.description -%}
{%- assign center_heading   = section.settings.center_heading -%}
{%- assign bg_color         = section.settings.background_color -%}
{%- assign card_bg          = section.settings.card_background_color -%}
{%- assign card_border_color = section.settings.card_border_color -%}
{%- assign heading_color    = section.settings.heading_color -%}
{%- assign text_color       = section.settings.text_color -%}
{%- assign link_color       = section.settings.link_color -%}
{%- assign btn_text_color   = section.settings.button_text_color -%}
{%- assign columns          = section.settings.columns_per_row -%}
{%- assign section_padding_top    = section.settings.padding_top -%}
{%- assign section_padding_bottom = section.settings.padding_bottom -%}

<style>
  #frd-educational-guides-{{ section.id }} {
    background-color: {{ bg_color }};
    padding-top: {{ section_padding_top }}px;
    padding-bottom: {{ section_padding_bottom }}px;
  }

  #frd-educational-guides-{{ section.id }} .frd-eg__wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header */
  #frd-educational-guides-{{ section.id }} .frd-eg__header {
    text-align: {% if center_heading %}center{% else %}left{% endif %};
    margin-bottom: 28px;
  }

  #frd-educational-guides-{{ section.id }} .frd-eg__section-title {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 10px;
    color: {{ heading_color }};
    text-transform: capitalize;
  }

  #frd-educational-guides-{{ section.id }} .frd-eg__description {
    font-size: 16px;
    line-height: 1.55;
    color: {{ text_color }};
    max-width: 700px;
    {% if center_heading %}margin: 0 auto;{% endif %}
  }

  /* Grid */
  #frd-educational-guides-{{ section.id }} .frd-eg__grid {
    display: grid;
    grid-template-columns: repeat({{ columns }}, 1fr);
    gap: 24px;
  }

  /* Card */
  #frd-educational-guides-{{ section.id }} .frd-eg__card {
    background: {{ card_bg }};
    border: 1px solid {{ card_border_color }};
    border-radius: 12px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  #frd-educational-guides-{{ section.id }} .frd-eg__card:hover {
    border-color: {{ link_color }};
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.10);
    transform: translateY(-4px);
  }

  /* Icon / emoji */
  #frd-educational-guides-{{ section.id }} .frd-eg__icon {
    font-size: 36px;
    line-height: 1;
    margin-bottom: 18px;
  }

  #frd-educational-guides-{{ section.id }} .frd-eg__icon img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  /* Card heading */
  #frd-educational-guides-{{ section.id }} .frd-eg__heading {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 10px;
    color: {{ heading_color }};
    line-height: 1.3;
  }

  /* Description */
  #frd-educational-guides-{{ section.id }} .frd-eg__text {
    font-size: 15px;
    line-height: 1.55;
    color: {{ text_color }};
    margin-bottom: 20px;
    flex-grow: 1;
  }

  /* Button */
  #frd-educational-guides-{{ section.id }} .frd-eg__button {
    display: inline-block;
    font-family: Helvetica, sans-serif;
    background-color: #e9841d;
    color: {{ btn_text_color }};
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
    margin-top: auto;
  }

  #frd-educational-guides-{{ section.id }} .frd-eg__button:hover {
    opacity: 0.88;
  }

  /* Responsive */
  @media screen and (max-width: 768px) {
    #frd-educational-guides-{{ section.id }} .frd-eg__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #frd-educational-guides-{{ section.id }} .frd-eg__card {
      padding: 24px 20px;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    #frd-educational-guides-{{ section.id }} .frd-eg__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<section id="frd-educational-guides-{{ section.id }}">
  <div class="frd-eg__wrapper">
    {% if section_title != blank or description != blank %}
      <div class="frd-eg__header">
        {% if section_title != blank %}
          <h2 class="frd-eg__section-title">{{ section_title }}</h2>
        {% endif %}
        {% if description != blank %}
          <div class="frd-eg__description">{{ description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="frd-eg__grid">
        {% for block in section.blocks %}
          <div class="frd-eg__card" {{ block.shopify_attributes }}>

            <div class="frd-eg__icon">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 112 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.heading }}"
                  loading="lazy"
                  width="56"
                  height="56"
                >
              {%- elsif block.settings.emoji != blank -%}
                {{ block.settings.emoji }}
              {%- endif -%}
            </div>

            {% if block.settings.heading != blank %}
              <h3 class="frd-eg__heading">{{ block.settings.heading }}</h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="frd-eg__text">{{ block.settings.description }}</p>
            {% endif %}

            {% if block.settings.button_text != blank %}
              <a
                class="frd-eg__button"
                href="{{ block.settings.link | default: '#' }}"
              >
                {{ block.settings.button_text }}
              </a>
            {% endif %}

          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Educational Guides",
  "class": "shopify-section--frd-educational-guides",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Educational Guides"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section Description",
      "info": "Displayed below the heading"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Center Heading & Description",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e2e8f0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2d3748"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4a5568"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Accent / Hover Color",
      "default": "#d4882b"
    },

    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "columns_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns Per Row (Desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "guide_card",
      "name": "Guide Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Icon (Image)",
          "info": "Optional — used instead of Emoji if provided"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Card Icon (Emoji)",
          "info": "Paste an emoji here, e.g. 🔥. Ignored if an image is set.",
          "default": "📖"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Guide Title"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description",
          "default": "A short summary of what this guide covers."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Read Guide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Educational Guides",
      "settings": {
        "title": "Educational Guides",
        "columns_per_row": 3
      },
      "blocks": [
        {
          "type": "guide_card",
          "settings": {
            "emoji": "🔥",
            "heading": "Gas vs. Wood vs. Pellet: Which Is Right for You?",
            "description": "Compare fuel types side-by-side to find the perfect match for your home, budget, and lifestyle.",
            "button_text": "Read Guide"
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "emoji": "🏠",
            "heading": "New Buyer's Guide to Fireplaces",
            "description": "Everything first-time buyers need to know — from sizing and venting to installation and costs.",
            "button_text": "Read Guide"
          }
        },
        {
          "type": "guide_card",
          "settings": {
            "emoji": "🔧",
            "heading": "When to Repair vs. Replace Your Fireplace",
            "description": "Learn the warning signs that it's time for a repair and when a full replacement makes more sense.",
            "button_text": "Read Guide"
          }
        }
      ]
    }
  ]
}
{% endschema %}
