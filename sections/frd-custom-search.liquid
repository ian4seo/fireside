{% comment %}
** Custom Search – frd-custom-search.liquid **
- Duplicated from search-template.liquid
- Adds: Need Help banner, Popular Categories grid, zero-result recovery
- Uses blocks
{% endcomment %}
{%- assign filter_tree_vertical_style = shop.metafields.bc-sf-filter.settings | split: 'general":' | last | split: 'filterTreeVerticalStyle":"' | last | split: '","' | first | strip -%}
{%- assign enable_filter_sticky_d = shop.metafields.bc-sf-filter.settings | split: 'general":' | last | split: 'stickyFilterOnDesktop":' | last | split: ',' | first | strip -%}
{%- assign enable_filter_sticky_m = shop.metafields.bc-sf-filter.settings | split: 'general":' | last | split: 'stickyFilterOnMobile":' | last | split: ',' | first |  split: '}}' | first | strip -%}

{%- assign enable_filter_tree_button_desktop_v = false -%}
{%- if filter_tree_vertical_style == 'style-off-canvas' or filter_tree_vertical_style == 'style-expand' -%}
  {%- assign enable_filter_tree_button_desktop_v = true -%}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} .search__container {
    width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .search__container .search__wrapper {
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .search__form {
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .frd-cs__need-help {
    background: #f7f7f7;
    border-radius: 10px;
    padding: 28px 24px;
    text-align: center;
    margin: 20px 0 30px;
    width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .frd-cs__need-help-title {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
    color: #333;
  }

  #shopify-section-{{ section.id }} .frd-cs__need-help-text {
    font-size: 15px;
    color: #555;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .frd-cs__need-help-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .frd-cs__btn--primary {
    display: inline-block;
    background-color: #e9841d;
    color: #fff;
    padding: 12px 28px;
    border-radius: 6px;
    text-decoration: none;
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }

  #shopify-section-{{ section.id }} .frd-cs__btn--primary:hover {
    opacity: 0.88;
  }

  #shopify-section-{{ section.id }} .frd-cs__link {
    color: #d4882b;
    font-family: Helvetica, Arial, sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-decoration: underline;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .frd-cs__popular-categories {
    padding: 10px 0;
    margin-bottom: 16px;
    width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .frd-cs__popular-title {
    text-align: center;
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 12px;
    color: #333;
    font-family: Helvetica, Arial, sans-serif;
  }

  #shopify-section-{{ section.id }} .frd-cs__popular-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .frd-cs__popular-btn {
    display: inline-block;
    flex: 1 1 0;
    text-align: center;
    border: 1.5px solid #d4882b;
    color: #d4882b;
    background: transparent;
    padding: 7px 8px;
    border-radius: 5px;
    font-family: Helvetica, Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
    text-transform: uppercase;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .frd-cs__popular-btn:hover {
    background: #e9841d;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .frd-cs__no-results {
    text-align: center;
    padding: 50px 20px;
  }

  #shopify-section-{{ section.id }} .frd-cs__no-results-title {
    font-size: 22px;
    font-weight: 700;
    color: #333;
    margin-bottom: 8px;
  }

  #shopify-section-{{ section.id }} .frd-cs__no-results-text {
    font-size: 16px;
    color: #555;
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .frd-cs__no-results-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .frd-cs__recovery-chip {
    display: inline-block;
    border: 2px solid #d4882b;
    color: #d4882b;
    padding: 10px 22px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.25s ease, color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .frd-cs__recovery-chip:hover {
    background: #e9841d;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .frd-cs__no-results-contact {
    font-size: 15px;
    color: #555;
  }

  #shopify-section-{{ section.id }} .frd-cs__no-results-contact a {
    color: #d4882b;
    font-weight: 600;
    text-decoration: underline;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .frd-cs__popular-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .frd-cs__popular-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

{%- assign search_pagination = section.settings.pagination_limit -%}
{% if section.settings.image != blank %}
<section class="section is-width-wide has-no-side-gutter">
  <a name="pagecontent" id="pagecontent"></a>
  <div class="container">
    <div class="one-whole column">
      <header class="banner center page-banner dark-overlay-{{ section.settings.image_darken }} full-width--true">
        {% render 'image-element',
        image: section.settings.image,
        alt: section.settings.image.alt,
        stretch_width: true
        %}
        <div class="caption captionOverlay--true">
          <h1 class="headline boost-pfs-search-result-header">{{ 'general.search.title' | t }}</h1>
        </div>
      </header>
    </div>
  </div>
</section>
{% endif %}
<section class="section 
  {% for result in search.results %}
    {% if result.object_type == 'product' and result.title contains "Stellar" %}
      stellar-product
      {% endif %}
  {% endfor %}">
  {% if section.settings.image == blank %}
  <a name="pagecontent" id="pagecontent"></a>
  {% endif %}
  <div class="container content">
    <div class="one-whole column">
      <div class="breadcrumb-collection">
        {% if section.settings.search_breadcrumb %}
        <script type="application/ld+json">
                {
                  "@context": "https://schema.org",
                  "@type": "BreadcrumbList",
                  "itemListElement": [
                    {
                      "@type": "ListItem",
                      "position": 1,
                      "item": {
                        "@id": "{{ shop.url }}",
                        "name": "{{ 'general.breadcrumbs.home' | t }}"
                    }
                  },
                  {
                    "@type": "ListItem",
                    "position": 2,
                    "item": {
                      "@id": "{{ routes.search_url }}",
                      "name": "{{ 'general.search.title' | t }}"
                    }
                  }
                ]
              }
            </script>
        <div class="breadcrumb_text">
          <a href="{{ routes.root_url }}" title="{{ shop.name | escape }}" class="breadcrumb_link">
            <span>{{ 'general.breadcrumbs.home' | t }}</span>
          </a>
          <span class="breadcrumb-divider">/</span>
          <a href="{{ routes.search_url }}" class="breadcrumb_link">
            <span class="boost-pfs-search-result-header">{% render 'boost-pfs-filter-skeleton', width: 4 %}</span>
          </a>
          <span class="boost-pfs-filter-top-pagination"></span>
        </div>
        {% endif %}
      </div>
    </div>

    {% if search.terms == blank %}
      <div class="frd-cs__popular-categories">
        <h2 class="frd-cs__popular-title">Popular Categories</h2>
        <div class="frd-cs__popular-grid">
          <a href="https://fireside.com/collections/gas-fireplaces" class="frd-cs__popular-btn">Gas Fireplaces</a>
          <a href="https://fireside.com/collections/gas-inserts" class="frd-cs__popular-btn">Gas Inserts</a>
          <a href="https://fireside.com/collections/electric-fireplaces" class="frd-cs__popular-btn">Electric Fireplaces</a>
          <a href="https://fireside.com/collections/wood-stoves-inserts" class="frd-cs__popular-btn">Wood Stoves &amp; Inserts</a>
          <a href="https://fireside.com/collections/pellet-stoves-inserts" class="frd-cs__popular-btn">Pellet Stoves &amp; Inserts</a>
          <a href="https://fireside.com/collections/outdoor-fireplaces-pits-tables" class="frd-cs__popular-btn">Outdoor Fireplaces</a>
        </div>
      </div>
    {% endif %}

    <div class="search__container" data-autocomplete-{{ settings.enable_autocomplete }}>
      <form class="search search__form" action="{{ routes.search_url }}">
        <div class="search__wrapper">
          <input type="hidden" name="type" value="{{ settings.search_option }}" />
          <input type="text" name="q" placeholder="{{ search_term }}" value="{{ search.terms | replace: '*', ''}}" x-webkit-speech autocapitalize="off" autocomplete="off" autocorrect="off" />
          <button type="submit" name="submit" class="search__button" value="">
            <span class="icon-search"></span>
          </button>
        </div>
      </form>
    </div>

    {% if section.settings.show_need_help %}
      <div class="frd-cs__need-help">
        <div class="frd-cs__need-help-inner">
          <h3 class="frd-cs__need-help-title">Need Help?</h3>
          <p class="frd-cs__need-help-text">
            Not sure what you're looking for? Our experts can help.
          </p>
          <div class="frd-cs__need-help-actions">
            <a href="{{ section.settings.chat_url }}" class="frd-cs__btn frd-cs__btn--primary">
              Talk with an Expert
            </a>
            <a href="{{ section.settings.consult_url }}" class="frd-cs__btn frd-cs__btn--primary">
              Schedule a Consultation
            </a>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- Zero-Result Recovery (hidden by default, shown via JS when Boost reports no results) -->
    <div id="frd-cs-no-result-recovery" style="display:none;text-align:center;padding:40px 20px;width:100%;box-sizing:border-box;">
      <h2 style="font-family:Helvetica,Arial,sans-serif;font-size:22px;font-weight:700;color:#333;margin-bottom:20px;text-transform:none;">We couldn't find what you're looking for. Try these instead:</h2>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-bottom:24px;">
        <a href="https://fireside.com/collections/gas-fireplaces" style="display:inline-block;border:1.5px solid #d4882b;color:#d4882b;background:transparent;padding:7px 8px;border-radius:5px;font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;text-decoration:none;text-transform:uppercase;">Gas Fireplaces</a>
        <a href="https://fireside.com/collections/gas-inserts" style="display:inline-block;border:1.5px solid #d4882b;color:#d4882b;background:transparent;padding:7px 8px;border-radius:5px;font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;text-decoration:none;text-transform:uppercase;">Gas Inserts</a>
        <a href="https://fireside.com/collections/electric-fireplaces" style="display:inline-block;border:1.5px solid #d4882b;color:#d4882b;background:transparent;padding:7px 8px;border-radius:5px;font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;text-decoration:none;text-transform:uppercase;">Electric Fireplaces</a>
        <a href="https://fireside.com/collections/wood-stoves-inserts" style="display:inline-block;border:1.5px solid #d4882b;color:#d4882b;background:transparent;padding:7px 8px;border-radius:5px;font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;text-decoration:none;text-transform:uppercase;">Wood Stoves &amp; Inserts</a>
        <a href="https://fireside.com/collections/pellet-stoves-inserts" style="display:inline-block;border:1.5px solid #d4882b;color:#d4882b;background:transparent;padding:7px 8px;border-radius:5px;font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;text-decoration:none;text-transform:uppercase;">Pellet Stoves &amp; Inserts</a>
        <a href="https://fireside.com/collections/outdoor-fireplaces-pits-tables" style="display:inline-block;border:1.5px solid #d4882b;color:#d4882b;background:transparent;padding:7px 8px;border-radius:5px;font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;text-decoration:none;text-transform:uppercase;">Outdoor Fireplaces</a>
      </div>
      <p style="font-family:Helvetica,Arial,sans-serif;font-size:15px;color:#555;margin-bottom:14px;">Still need help?</p>
      <div style="display:flex;justify-content:center;align-items:center;gap:16px;flex-wrap:wrap;">
        <a href="{{ section.settings.chat_url }}" style="display:inline-block;background-color:#e9841d;color:#fff;padding:12px 28px;border-radius:6px;text-decoration:none;font-family:Helvetica,Arial,sans-serif;font-weight:600;font-size:15px;text-transform:uppercase;">Talk with an Expert</a>
        <a href="{{ section.settings.consult_url }}" style="display:inline-block;background-color:#e9841d;color:#fff;padding:12px 28px;border-radius:6px;text-decoration:none;font-family:Helvetica,Arial,sans-serif;font-weight:600;font-size:15px;text-transform:uppercase;">Schedule a Consultation</a>
      </div>
    </div>

    <div class="one-whole column boost-pfs-search-result-toolbar">
      <div class="boost-pfs-search-result-item">
        <ul class="boost-pfs-search-result-panel-controls">
          <li>{% render 'boost-pfs-filter-skeleton', width: 2 %}</li>
          <li>{% render 'boost-pfs-filter-skeleton', width: 2 %}</li>
          <li>{% render 'boost-pfs-filter-skeleton', width: 1 %}</li>
        </ul>
      </div>
      <div class="boost-pfs-search-result-item">
        <span class="boost-pfs-search-total-result">
          {% render 'boost-pfs-filter-skeleton', width: 2 %}
        </span>
      </div>
    </div>
    {% comment %} Check to see if sidebar should be enabled {% endcomment %}
    {%- if enable_filter_tree_button_desktop_v  -%}
      <div class="boost-pfs-filter-tree-desktop-button-wrapper {% if enable_filter_sticky_d  %} boost-pfs-filter-tree-desktop-button-sticky-wrapper {% endif %}">
        <div class="boost-pfs-filter-tree-desktop-button">{%- render 'boost-pfs-filter-skeleton', type: 'button' -%}</div>
    {%- endif -%}
      <div class="one-whole column section_select boost-pfs-search-panel-product-show">
      <select aria-label="Sort by" class="sort_by boost-pfs-filter-top-sorting">
        {% render 'boost-pfs-filter-skeleton', width: 2 %}
      </select>
    </div>
    {%- if enable_filter_tree_button_desktop_v  -%}
      </div>
    {%- endif -%}

    
    {% if section.settings.image == blank %}
    <div class="one-whole column">
      <div class="feature_divider"></div>
    </div>
    {% endif %}
    {%- assign sidebar = true -%}

    <div class="content-wrapper is-flex is-flex-wrap boost-pfs-filter-wrapper">
      <div class="boost-pfs-filter-left-col" {% if context=='product' %}data-product-sidebar{% endif %}>
        <div class="sidebar-wrap">
          <div class="boost-pfs-filter-tree-mobile-button">
            {% render 'boost-pfs-filter-skeleton', type: 'button' %}
          </div>
          <div class="boost-pfs-filter-tree boost-pfs-filter-tree-v">
            {%- unless enable_filter_tree_button_desktop_v -%}
              {% render 'boost-pfs-filter-skeleton', type: 'filter-tree' %}
            {%- endunless -%}
          </div>
        </div>
      </div>
      <div class="boost-pfs-filter-right-col">
        <div class="container">
          <div class="one-whole column">

            <div itemtype="http://schema.org/ItemList" class="boost-pfs-filter-products is-flex is-flex-wrap product-list clearfix equal-columns--clear equal-columns--outside-trim">
              {% comment %} Fix Shopify search term report {% endcomment %}
              {% paginate search.results by 2 %}
              {% if search.performed %}
              {% for item in search.results %}
              <div class="grid__item" style="display: none !important"></div>
              {% endfor %}
              {% endif %}
              {% endpaginate %}
            </div>
            <div class="boost-pfs-filter-bottom-pagination paginate"></div>
            <div class="boost-pfs-filter-load-more"></div>
          </div>
        </div>
      </div>
      <div class="boost-pfs-search-result-wrap boost-hidden">
        <div class="boost-pfs-search-result-collections">
          <div class="boost-pfs-search-result-list-item"><a href="#">{% render 'boost-pfs-filter-skeleton', width: 4 %}</a></div>
          <div class="boost-pfs-search-result-list-item"><a href="#">{% render 'boost-pfs-filter-skeleton', width: 3 %}</a></div>
          <div class="boost-pfs-search-result-list-item"><a href="#">{% render 'boost-pfs-filter-skeleton', width: 4 %}</a></div>
        </div>
        <div class="boost-pfs-search-result-collection-pagination paginate">{% render 'boost-pfs-filter-skeleton', width: 4 %}</div>
      </div>
      <div class="boost-pfs-search-result-wrap boost-hidden">
        <div class="boost-pfs-search-result-pages">
          <div class="boost-pfs-search-result-list-item"><a href="#">{% render 'boost-pfs-filter-skeleton', width: 4 %}</a></div>
          <div class="boost-pfs-search-result-list-item"><a href="#">{% render 'boost-pfs-filter-skeleton', width: 3 %}</a></div>
          <div class="boost-pfs-search-result-list-item"><a href="#">{% render 'boost-pfs-filter-skeleton', width: 4 %}</a></div>
        </div>
        <div class="boost-pfs-search-result-page-pagination paginate">{% render 'boost-pfs-filter-skeleton', width: 4 %}</div>
      </div>
    </div>
  </div>
</section>

<script>
// Declare boostPFSThemeConfig variable
var boostPFSThemeConfig = {
  label: {
    sale: {{ 'product.badge.sale' | t | json}},
    sold_out: {{ 'product.badge.sold_out' | t | json }},
    sold_out_text: {{ settings.sold_out_text | json }},
    new: {{ 'collections.general.new' | t | json }},
    coming_soon: {{ 'collections.general.coming_soon' | t | json }},
    pre_order: {{ 'collections.general.pre_order' | t | json}},
    quick_shop: {{ 'collections.general.quick_shop' | t | json }},
    free_price: {{ settings.free_price_text | json }},
    from_price: {{ 'products.general.from' | t | json }},
    view_detail: {{ 'collections.general.view_product_details' | t | escape | json }},
    breadcrumb_page: {{ 'general.breadcrumbs.page' | t | json }},
    breadcrumb_home: {{ 'general.breadcrumbs.home' | t | json}},
    paginate_prev: {{ 'shopify.pagination.previous' | t | json }},
    paginate_next: {{ 'shopify.pagination.next' | t | json }}
  },
  custom: {
    sidebar: {% if sidebar != nil %} {{ sidebar | json }} {% else %} false {% endif %},
    products_per_page: {% if section.settings.pagination_limit %} {{ section.settings.pagination_limit | json }} {% else %} 20 {% endif %},
    products_per_row: {% if section.settings.products_per_row %} {{ section.settings.products_per_row }} {% else %} 4 {% endif %},
    mobile_products_per_row: {% if settings.mobile_products_per_row %} {{ settings.mobile_products_per_row | json }} {% else %} '1' {% endif %},
    secondary_image: {% if settings.collection_secondary_image != nil %} {{ settings.collection_secondary_image | json }} {% else %} false {% endif %},
    sale_banner_enabled: {% if settings.sale_banner_enabled != nil %} {{ settings.sale_banner_enabled | json }} {% else %} false {% endif %},
    image_loading_style: {% if settings.image_loading_style %} {{ settings.image_loading_style | json }} {% else %} '' {% endif %},
    vendor_enable: {% if settings.display_vendor != nil %} {{ settings.display_vendor | json }} {% else %} false {% endif %},
    quick_shop_enabled: {% if settings.quick_shop_enabled != nil %} {{ settings.quick_shop_enabled | json }} {% else %} false {% endif %},
    quick_shop_style: {% if settings.quick_shop_style %} {{ settings.quick_shop_style | json }} {% else %} "popup" {% endif %},
    collection_swatches: {% if settings.collection_swatches != nil %} {{ settings.collection_swatches | json }} {% else %} false {% endif %},
    description_words: {% if settings.description_words %} {{ settings.description_words | json }} {% else %} 25 {% endif %},
    loader_image_url: "{{ 'loader.gif' | asset_url }}",
    thumbnail_hover_enabled: {% if settings.thumbnail_hover_enabled != nil %} {{ settings.thumbnail_hover_enabled | json }} {% else %} false {% endif %},
    enable_shopify_collection_badges: {% if settings.enable_shopify_collection_badges != nil %} {{ settings.enable_shopify_collection_badges | json }} {% else %} false {% endif %},
    enable_shopify_review_comments: {% if settings.enable_shopify_review_comments != nil %} {{ settings.enable_shopify_review_comments | json }} {% else %} false {% endif %},
    align_height: {% if settings.align_height != nil %} {{ settings.align_height | json }} {% else %} false {% endif %},
    collection_height: {% if settings.collection_height %} {{ settings.collection_height | plus: 0 }} {% else %} 0 {% endif %},
    pagination_type: {% if settings.pagination_type %} {{ settings.pagination_type | json }} {% else %} "basic_pagination" {% endif %},
    currency_format: {% if settings.currency_format %} {{ settings.currency_format | json }} {% else %} "money_with_currency_format" {% endif %},
    display_price: {% if settings.display_price != nil %} {{ settings.display_price | json }} {% else %} false {% endif %},
    sticker_style: {% if settings.sticker_style %} {{ settings.sticker_style | json }} {% else %} '' {% endif %}
  }
};

// Declare Templates
var boostPFSTemplate = {
  // Grid Template
  'productGridItemHtml': {% render 'boost-pfs-filter-html', layout: 'productGridItemHtml' %},

  // Label Template
  'quickViewBtnHtml':  {% render 'boost-pfs-filter-html', layout: 'quickViewBtnHtml' %},
  'newRowHtml': {% render 'boost-pfs-filter-html', layout: 'newRowHtml' %},

  // Pagination Template
  'previousHtml': {% render 'boost-pfs-filter-html', layout: 'previousHtml' %},
  'nextHtml': {% render 'boost-pfs-filter-html', layout: 'nextHtml' %},
  'pageItemHtml': {% render 'boost-pfs-filter-html', layout: 'pageItemHtml' %},
  'pageItemSelectedHtml': {% render 'boost-pfs-filter-html', layout: 'pageItemSelectedHtml' %},
  'pageItemRemainHtml': {% render 'boost-pfs-filter-html', layout: 'pageItemRemainHtml' %},
  'paginateHtml': {% render 'boost-pfs-filter-html', layout: 'paginateHtml' %},

  // Sorting Template
  'sortingHtml': {% render 'boost-pfs-filter-html', layout: 'sortingHtml' %},
};

/* ── Zero-Result Recovery: show/hide the recovery block below Need Help ── */
(function() {
  var recovery = document.getElementById('frd-cs-no-result-recovery');
  if (!recovery) return;

  function checkNoResults() {
    var hasNoResultClass = document.body.classList.contains('boost-pfs-search-no-result-body');
    var productGrid = document.querySelector('.boost-pfs-filter-products');
    var gridEmpty = productGrid && productGrid.querySelectorAll('.grid__item, .product-list__item, [class*="product"]').length === 0 && productGrid.textContent.trim().length > 0;
    var needHelp = document.querySelector('.frd-cs__need-help');

    if (hasNoResultClass || gridEmpty) {
      recovery.style.display = 'block';
      if (needHelp) needHelp.style.display = 'none';
    } else {
      recovery.style.display = 'none';
      if (needHelp) needHelp.style.display = '';
    }
  }

  /* Watch body class changes */
  var bodyObserver = new MutationObserver(function() {
    setTimeout(checkNoResults, 200);
  });
  bodyObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });

  /* Watch for Boost rendering in the filter area */
  var filterArea = document.querySelector('.boost-pfs-filter-wrapper') ||
                   document.querySelector('.boost-pfs-filter-right-col') ||
                   document.body;
  var domObserver = new MutationObserver(function() {
    setTimeout(checkNoResults, 200);
  });
  domObserver.observe(filterArea, { childList: true, subtree: true });

  /* Poll to catch async Boost rendering */
  var pollCount = 0;
  var pollTimer = setInterval(function() {
    checkNoResults();
    pollCount++;
    if (pollCount > 30) clearInterval(pollTimer);
  }, 500);
})();
</script>
