<script
  type="application/json"
  data-section-type="image-video-sliders-slider"
  data-section-id="{{ section.id }}"
>
</script>

{%- assign id = section.id -%}
{%- assign blocks = section.blocks -%}
{%- assign title = section.settings.title | escape -%}
{%- assign css_id = section.settings.css_id -%}
{%- assign custom_css = section.settings.custom_css -%}

{% style %}
  {%
    render 'css-loop',
    css: custom_css,
    id: id
  %}
  
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  
  .frd-image-video-slider {
    background-color: {{ section.settings.bg_color }};
  }

  @media only screen and (min-width: 798px) {
    .frd-image-video-slider .frd-image-video-slider-heading {
      font-size: 36px;
      margin-bottom: 0px!important;
    }
    .frd-image-video-slider-description {
      font-size: 18px;
      line-height: 26px;
      padding-right: 70px;
    }
    .frd-image-video-slider-media img {
      margin-right: -30px;
      min-height: 400px !important;
      object-fit: cover !important;
    }
    .frd-image-video-slider-media {
      width: 40%;
    }
    .frd-image-video-slider-content {
      width: 60%;
    }
  }

  @media only screen and (max-width: 798px) {
    .frd-image-video-slider .frd-image-video-slider-heading {
      font-size: 36px;
    }
    .frd-image-video-slider-description {
      font-size: 16px;
      line-height: 1.6;
    }
    .frd-image-video-slider .frd-image-video-slider-heading {
      margin-bottom: 0px!important;
    }
    .frd-image-video-slider-media img {
      min-height: 400px !important;
      height: 100%!important;
      object-fit: cover;
      width: 100% !important;
      min-width: 400px !important;
    }
    .frd-image-video-slider-media {
      width: 100%;
    }
    .frd-image-video-slider-content {
      width: 100%;
    }
  }
  
  .frd-image-video-slider .frd-image-video-slider-heading {
    font-weight: 600;
    text-align: center;
    color: #000;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .frd-image-video-sliders-container h2 {
    font-family: 'Helvetica'!important;
  }
  
  .frd-image-video-sliders-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 60px;
  }
  
  .frd-image-video-slider-slider {
    position: relative;
    overflow: hidden;
  }
  
  .frd-image-video-slider-slides-container {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }
  
  .frd-image-video-slider-slide {
    display: flex;
    align-items: center;
    padding: 40px 0;
    width: 100%;
    flex-shrink: 0;
  }
  
  .frd-image-video-slider-media {
    position: relative;
  }
  
  .frd-image-video-slider-media.video-media {
    flex: 0 0 500px;
    max-width: 500px;
  }
  
  .frd-image-video-slider-content {
    padding-left: 40px;
  }
  
  .frd-image-video-slider-media img {
    width: 100%;
    height: auto;
  }
  
  .frd-image-video-slider-video {
    width: 100%;
    height: 450px;
    border-radius: 8px;
    border: none;
  }
  
  .frd-video-placeholder {
    position: relative;
    width: 100%;
    height: 450px;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: #000;
    max-width: 360px;
    margin: auto;
  }
  
  .frd-video-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }
  
  .frd-play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
  
  .frd-play-button:hover {
    background: rgba(255, 255, 255, 1);
    transform: translate(-50%, -50%) scale(1.1);
  }
  
  .frd-play-button svg {
    width: 32px;
    height: 32px;
    fill: #333;
    margin-left: 4px;
  }
  
  .frd-star {
    width: 24px;
    height: 24px;
    color: #ff9500;
  }
  
  .frd-image-video-slider-headline {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 20px;
    color: #000;
    line-height: 1.3;
  }
  
  .frd-image-video-slider-description {
    color: #333;
  }
  
  .frd-slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
    opacity: 0.7;
  }
  
  .frd-slider-nav:hover {
    opacity: 1;
  }
  
  .frd-slider-nav.prev {
    left: -18px;
  }
  
  .frd-slider-nav.next {
    right: -18px;
  }
  
  .frd-slider-nav svg {
    width: 48px;
    height: 48px;
    fill: #000;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }
  
  @media (max-width: 768px) {
    .frd-image-video-slider-heading {
      font-size: 36px;
      margin-bottom: 40px;
    }
    .frd-image-video-slider-slide {
      flex-direction: column;
      gap: 30px;
      text-align: center;
    }
    .frd-image-video-slider-content {
      padding-left: 0;
    }
    .frd-image-video-sliders-container {
      padding: 0 20px;
    }
    .frd-image-video-slider-media {
      flex: none;
      max-width: 100%;
    }
    .frd-image-video-slider-media.video-media {
      flex: none;
      max-width: 100%;
    }
    .frd-image-video-slider-video {
      height: 300px;
    }
    .frd-video-placeholder {
      height: 300px;
    }
    .frd-play-button {
      width: 60px;
      height: 60px;
    }
    .frd-play-button svg {
      width: 24px;
      height: 24px;
    }
    .frd-slider-nav {
      position: relative;
      top: auto;
      transform: none;
      width: 50px;
      height: 50px;
    }
    .frd-slider-nav.prev {
      left: auto;
      margin-right: 20px;
    }
    .frd-slider-nav.next {
      right: auto;
    }
    .frd-slider-nav svg {
      width: 40px;
      height: 40px;
    }
    .frd-slider-navigation {
      display: flex;
      justify-content: center;
    }
  }

  .image-video-slider-divider {
    border-top: 1px solid #000;
    border-bottom: 0px!important;
  }
{% endstyle %}

{% if blocks.size > 0 %}
<section class="frd-image-video-slider" id="{{ css_id }}">
  <div class="frd-image-video-sliders-container">
    
    {% if title != blank %}
      <h2 class="frd-image-video-slider-heading">{{ title }}</h2>
    {% endif %}
    <div class="frd-image-video-slider-slider" id="image-video-sliders-{{ section.id }}">
      <div class="frd-image-video-slider-slides-container" id="slides-container-{{ section.id }}">
      
        {% for block in blocks %}
          <div class="frd-image-video-slider-slide" {{ block.shopify_attributes }}>
            
            <!-- Media Section -->
            <div class="frd-image-video-slider-media {% if block.settings.media_type == 'video' %}video-media{% endif %}">
              {% if block.settings.media_type == 'video' and block.settings.video_url != blank %}
                {% assign video_url = block.settings.video_url %}
                {% if video_url contains 'vimeo.com' %}
                  {% assign vimeo_id = video_url | split: '/' | last %}
                  <div class="frd-video-placeholder" onclick="playVideo(this, 'vimeo', '{{ vimeo_id }}')">
                    {% if block.settings.placeholder_image != blank %}
                      <img src="{{ block.settings.placeholder_image | image_url: width: 1000 }}" alt="{{ block.settings.placeholder_image.alt | default: 'Video thumbnail' }}" loading="lazy" decoding="async" width="{{ block.settings.placeholder_image.width }}" height="{{ block.settings.placeholder_image.height }}">
                    {% else %}
                      <img src="https://vumbnail.com/{{ vimeo_id }}.jpg" alt="Video thumbnail" loading="lazy" decoding="async" width="1280" height="720">
                    {% endif %}
                    <div class="frd-play-button">
                      <svg viewBox="0 0 24 24">
                        <path d="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                      </svg>
                    </div>
                  </div>
                {% elsif video_url contains 'youtube.com' or video_url contains 'youtu.be' %}
                  {% if video_url contains 'youtu.be' %}
                    {% assign youtube_id = video_url | split: '/' | last %}
                  {% else %}
                    {% assign youtube_id = video_url | split: '?v=' | last | split: '&' | first %}
                  {% endif %}
                  <div class="frd-video-placeholder" onclick="playVideo(this, 'youtube', '{{ youtube_id }}')">
                    {% if block.settings.placeholder_image != blank %}
                      <img src="{{ block.settings.placeholder_image | image_url: width: 1000 }}" alt="{{ block.settings.placeholder_image.alt | default: 'Video thumbnail' }}" loading="lazy" decoding="async" width="{{ block.settings.placeholder_image.width }}" height="{{ block.settings.placeholder_image.height }}">
                    {% else %}
                      <img src="https://img.youtube.com/vi/{{ youtube_id }}/maxresdefault.jpg" alt="Video thumbnail" loading="lazy" decoding="async" width="1280" height="720">
                    {% endif %}
                    <div class="frd-play-button">
                      <svg viewBox="0 0 24 24">
                        <path d="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                      </svg>
                    </div>
                  </div>
                {% else %}
                  <div class="frd-video-placeholder" onclick="playVideo(this, 'direct', '', '{{ video_url }}')">
                    {% if block.settings.placeholder_image != blank %}
                      <img src="{{ block.settings.placeholder_image | image_url: width: 1000 }}" alt="{{ block.settings.placeholder_image.alt | default: 'Video thumbnail' }}" loading="lazy" decoding="async" width="{{ block.settings.placeholder_image.width }}" height="{{ block.settings.placeholder_image.height }}">
                    {% else %}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                    <div class="frd-play-button">
                      <svg viewBox="0 0 24 24">
                        <path d="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                      </svg>
                    </div>
                  </div>
                {% endif %}
              {% else %}
                {% if block.settings.image != blank %}
                  {%
                    render 'image-element',
                    image: block.settings.image,
                    alt: block.settings.image.alt,
                    stretch_width: true
                  %}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              {% endif %}
            </div>
          
          <!-- Content Section -->
          <div class="frd-image-video-slider-content">
            
            
            <!-- Headline -->
            {% if block.settings.headline != blank %}
              <h3 class="frd-image-video-slider-headline">{{ block.settings.headline | escape }}</h3>
            {% endif %}
            
            <!-- Description -->
            {% if block.settings.description != blank %}
              <div class="frd-image-video-slider-description">
                {{ block.settings.description }}
              </div>
            {% endif %}
            
            </div>
          </div>
        {% endfor %}
        
      </div> <!-- Close slides container -->
      
      <!-- Navigation Arrows -->
      {% if blocks.size > 1 %}
        <button class="frd-slider-nav prev " onclick="previousSlide('{{ section.id }}')">
          <svg viewBox="0 0 24 24"  class="frd-slider-nav-prev-btn">
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"/>
          </svg>
        </button>
        <button class="frd-slider-nav next " onclick="nextSlide('{{ section.id }}')">
          <svg viewBox="0 0 24 24" class="frd-slider-nav-next-btn">
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/>
          </svg>
        </button>
        
        <!-- Mobile Navigation -->
        <div class="frd-slider-navigation" style="display: none;">
          <button class="frd-slider-nav prev" onclick="previousSlide('{{ section.id }}')">
            <svg viewBox="0 0 24 24"   class="frd-slider-nav-prev-btn">
              <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"/>
            </svg>
          </button>
          <button class="frd-slider-nav next" onclick="nextSlide('{{ section.id }}')">
            <svg viewBox="0 0 24 24" class="frd-slider-nav-next-btn">
              <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/>
            </svg>
          </button>
        </div>
      {% endif %}
      
    </div>
  </div>
  <hr class="image-video-slider-divider">
</section>
{% endif %}

<script>
// image-video-sliders Slider JavaScript
(function() {
  const sliders = {};
  
  function initSlider(sectionId) {
    const slidesContainer = document.querySelector(`#slides-container-${sectionId}`);
    const slides = document.querySelectorAll(`#image-video-sliders-${sectionId} .frd-image-video-slider-slide`);
    
    sliders[sectionId] = {
      currentSlide: 0,
      totalSlides: slides.length,
      slidesContainer: slidesContainer
    };
    
    // Set initial position
    updateSliderPosition(sectionId);
  }
  
  function updateSliderPosition(sectionId) {
    const slider = sliders[sectionId];
    if (slider && slider.slidesContainer) {
      const translateX = -slider.currentSlide * 100;
      slider.slidesContainer.style.transform = `translateX(${translateX}%)`;
    }
  }
  
  window.nextSlide = function(sectionId) {
    if (!sliders[sectionId]) initSlider(sectionId);
    
    const slider = sliders[sectionId];
    slider.currentSlide = (slider.currentSlide + 1) % slider.totalSlides;
    updateSliderPosition(sectionId);
  };
  
  window.previousSlide = function(sectionId) {
    if (!sliders[sectionId]) initSlider(sectionId);
    
    const slider = sliders[sectionId];
    slider.currentSlide = slider.currentSlide === 0 ? 
      slider.totalSlides - 1 : slider.currentSlide - 1;
    updateSliderPosition(sectionId);
  };
  
  // Video play functionality
  window.playVideo = function(element, type, videoId, directUrl) {
    let videoHTML = '';
    
    switch(type) {
      case 'vimeo':
        videoHTML = `<iframe 
          class="frd-image-video-slider-video"
          src="https://player.vimeo.com/video/${videoId}?autoplay=1&muted=1&loop=0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen>
        </iframe>`;
        break;
      case 'youtube':
        videoHTML = `<iframe 
          class="frd-image-video-slider-video"
          src="https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>`;
        break;
      case 'direct':
        videoHTML = `<iframe 
          class="frd-image-video-slider-video"
          src="${directUrl}?autoplay=1"
          allowfullscreen>
        </iframe>`;
        break;
    }
    
    if (videoHTML) {
      // Store parent reference before replacement
      const parentElement = element.parentNode;
      
      // Replace the placeholder with video
      element.outerHTML = videoHTML;
      
      // Additional fallback: try to trigger play after iframe loads
      setTimeout(() => {
        const iframe = parentElement.querySelector('.frd-image-video-slider-video');
        if (iframe) {
          // Force reload with autoplay for stubborn browsers
          const currentSrc = iframe.src;
          iframe.src = '';
          setTimeout(() => {
            iframe.src = currentSrc;
          }, 50);
        }
      }, 200);
    }
  };
  
  // Initialize slider for this section
  document.addEventListener('DOMContentLoaded', function() {
    initSlider('{{ section.id }}');
    
    // Show mobile navigation on mobile devices
    updateNavigationDisplay();
  });
  
  // Handle window resize
  window.addEventListener('resize', function() {
    updateNavigationDisplay();
    
    // Recalculate position on resize
    if (sliders['{{ section.id }}']) {
      updateSliderPosition('{{ section.id }}');
    }
  });
  
  function updateNavigationDisplay() {
    const mobileNav = document.querySelector(`#image-video-sliders-{{ section.id }} .frd-slider-navigation`);
    const desktopNavs = document.querySelectorAll(`#image-video-sliders-{{ section.id }} .frd-slider-nav:not(.frd-slider-navigation .frd-slider-nav)`);
    
    if (window.innerWidth <= 768) {
      if (mobileNav) {
        mobileNav.style.display = 'flex';
        desktopNavs.forEach(nav => nav.style.display = 'none');
      }
    } else {
      if (mobileNav) {
        mobileNav.style.display = 'none';
        desktopNavs.forEach(nav => nav.style.display = 'flex');
      }
    }
  }
})();
</script>

{% schema %}
{
