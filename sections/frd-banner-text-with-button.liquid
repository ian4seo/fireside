<section class="{{ section.settings.text_align }} page-plain-rich-text frd-banner-text-with-button" 
  style="{% if section.settings.background_image %}background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');
  {% endif %}--button-bg-color: {{ section.settings.button_bg_color | default: '#212626' }}; 
   {% if section.settings.bg_color %}background-color: {{ section.settings.bg_color | default: '#e9841d' }};{% endif %}">
	{% if section.settings.background_image %}
		<div class="frd-banner-overlay"></div>
	{% endif %}
	<div class="frd-banner-content">
		<h2 class="minion-pro">{{ section.settings.heading }}</h2>
		{% if section.settings.sub_text != blank %}
			<p>{{ section.settings.sub_text }}</p>
		{% endif %}
	 	{% if section.settings.button_label != blank %}
			<a target="_blank" rel="noopener noreferrer" class="global-button" href="{% if section.settings.button_link %}{{ section.settings.button_link }}{% else %} #{% endif %}">{{ section.settings.button_label }}</a>
		{% endif %}
	</div>
</section>

<style>
  /* Download Design Guide */ 
  #shopify-section-template--19598484799718__frd_banner_text_with_button_PYxm6y > section {
    padding-top: 50px!important;
    padding-bottom: 90px!important;
    min-height: 200px;
  }

.frd-banner-text-with-button {
  background-size: cover!important;
  background-position: center center!important;
  background-repeat: no-repeat!important;
  padding-left: 20px;
  padding-right: 20px;
  position: relative;
  width: 100%;
  padding-top: 60px;
  padding-bottom: 60px;
  min-height: 200px;
}

.frd-banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1;
}

.frd-banner-content {
  position: relative;
  z-index: 2;
}

.frd-banner-text-with-button h2 {
  color: #fff!important;
  font-family: 'Helvetica'!important;
  font-weight: 600!important;
  margin-bottom: 40px;
}

.frd-banner-text-with-button p {
  color: #fff!important;
}

.frd-banner-text-with-button a {
  background-color: var(--button-bg-color, #212626)!important;
  color: #fff!important;
  text-transform: capitalize!important;
  width: 100%;
  max-width: 450px;
  border: 0px!important;
  letter-spacing: 0px!important;
}

.frd-banner-text-with-button a:hover {
  background-color: #fff!important;
  color: #000!important;
  transition: 0.4s;
}

@media only screen and (min-width: 798px) {
  .frd-banner-text-with-button h2 {
    font-size: 36px!important;
  }
  .frd-banner-text-with-button a {
    font-size: 20px;
  }
}

@media only screen and (max-width: 798px) {
  .frd-banner-text-with-button h2 {
    font-size: 30px!important;
  }
  .frd-banner-text-with-button a {
    font-size: 20px;
  }
}

.frd-banner-text-with-button h3 {
  color: #fff!important;
}
</style>

{% schema %}
{
    "name": "Banner Text w/Button",
    "tag": "section",
    "settings": [
		{
			"id": "heading",
			"type": "text",
			"label": "Heading",
			"default": "Lorem Ipsum Dolor"
		},
		{
			"type": "richtext",
			"id": "sub_text",
			"label": "Paragraph Text"
		},
        {
            "type": "text",
            "id": "button_label",
            "label": "Button label"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
        },
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "Background Image",
            "info": "Recommended size: 1920x600px or larger. If no image is selected, the orange background color will be used."
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#e9841d"
        },
        {
            "type": "color",
            "id": "button_bg_color",
            "label": "Button Background Color",
            "default": "#212626"
        },
		{
		  "type": "select",
		  "id": "text_align",
		  "label": "Text Align",
		  "default": "text-center",
		  "options": [
		    {
		      "value": "",
		      "label": "Left"
		    },
		    {
		      "value": "text-center",
		      "label": "Center"
		    },
		    {
		      "value": "text-right",
		      "label": "Right"
		    }
		  ]
		}
    ],
    "presets": [{
		"name": "Banner Text w/Button"
    }]
}
{% endschema %}