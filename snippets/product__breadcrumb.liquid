{% assign bc_collection = collection %}
  {% unless bc_collection %}
    {% for c in product.collections %}
      {% unless c.handle == 'all' or c.handle == 'all-products' or c.handle == 'all-product' %}
        {% assign bc_collection = c %}
        {% break %}
      {% endunless %}
    {% endfor %}
  {% endunless %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": {
            "@id": "{{ shop.url }}",
            "name": "{{ 'general.breadcrumbs.home' | t }}"
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
            {% if bc_collection %}
              "@id": "{{ bc_collection.url }}",
              "name": "{{ bc_collection.title | escape }}"
            {% else %}
              "@id": "{{ routes.all_products_collection_url }}",
              "name": "{{ collections.all.title | escape }}"
            {% endif %}
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "item": {
            "@id": "{{ product.url }}",
            "name": "{{ product.title | escape }}"
          }
        }
      ]
    }
  </script>

  <div class="breadcrumb_text">
    <a href="{{ routes.root_url }}" title="{{ shop.name | escape }}" class="breadcrumb_link">
      <span>{{ 'general.breadcrumbs.home' | t }}</span>
    </a>
    <span class="breadcrumb-divider">/</span>
    {% if bc_collection %}
      <a href="{{ bc_collection.url }}" title="{{ bc_collection.title | escape }}" class="breadcrumb_link">
        <span>{{ bc_collection.title }}</span>
        </a>
    {% else %}
      <a href="{{ routes.all_products_collection_url }}" title="{{ collections.all.title }}" class="breadcrumb_link">
        <span>{{ collections.all.title }}</span>
        </a>
    {% endif %}
    <span class="breadcrumb-divider">/</span>
    <a href="{{ product.url }}" class="breadcrumb_link">
      <span>{{ product.title }}</span>
    </a>
  </div>
